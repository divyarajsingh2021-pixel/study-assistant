# ==========================================
# AI Study Assistant - Environment Config
# ==========================================

# Preferred LLM Provider: 'auto', 'ollama', 'groq', or 'offline'
PREFERRED_PROVIDER=auto

# Ollama Settings (Local AI - 100% Free)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq API Settings (Cloud Option - Free Tier)
# Optional: Leave empty to run 100% locally with Ollama or the Heuristic Engine
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Vector DB & Storage
CHROMA_COLLECTION_NAME=study_documents
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_PER_MINUTE=60
